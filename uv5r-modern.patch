+import unittest
+
+from chirp import chirp_common
+from chirp import uv5r_setup
+
+
+def memory(freq, mode="FM", duplex="", offset=0, name="RPT"):
+    result = chirp_common.Memory()
+    result.freq = freq
+    result.mode = mode
+    result.duplex = duplex
+    result.offset = offset
+    result.name = name
+    return result
+
+
+class UV5RSetupTest(unittest.TestCase):
+    def test_presets(self):
+        result = uv5r_setup.build_plan([])
+        self.assertEqual(9, len(result))
+        self.assertEqual([146_520_000, 446_000_000],
+                         [item.freq for item in result[:2]])
+        self.assertTrue(all(item.duplex == "off" for item in result[2:]))
+
+    def test_filters_digital_out_of_range_and_duplicates(self):
+        result = uv5r_setup.build_plan([
+            memory(146_940_000, duplex="-", offset=600_000),
+            memory(146_940_000, duplex="-", offset=600_000, name="DUPE"),
+            memory(145_000_000, mode="DMR"),
+            memory(900_000_000),
+        ], add_calling=False, add_noaa=False)
+        self.assertEqual(1, len(result))
+        self.assertEqual("RPT", result[0].name)
+
+    def test_same_receive_frequency_different_input_is_not_duplicate(self):
+        result = uv5r_setup.build_plan([
+            memory(146_940_000, duplex="-", offset=600_000),
+            memory(146_940_000, duplex="+", offset=600_000),
+        ], add_calling=False, add_noaa=False)
+        self.assertEqual(2, len(result))
+
+    def test_limit_and_numbering(self):
+        repeaters = [memory(144_000_000 + index * 5_000,
+                            name="LONGNAME%d" % index)
+                     for index in range(200)]
+        result = uv5r_setup.build_plan(
+            repeaters, add_calling=False, add_noaa=False)
+        self.assertEqual(128, len(result))
+        self.assertEqual(list(range(128)), [item.number for item in result])
+        self.assertTrue(all(len(item.name) <= 7 for item in result))
+
+    def test_custom_limit(self):
+        result = uv5r_setup.build_plan([], maximum=1)
+        self.assertEqual(1, len(result))
