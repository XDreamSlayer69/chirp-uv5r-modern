+import os
+import tempfile
+import unittest
+from unittest import mock
+
+os.environ.setdefault("QT_QPA_PLATFORM", "offscreen")
+
+from PySide6 import QtCore, QtTest, QtWidgets
+
+from chirp import chirp_common
+from chirp import modern
+
+
+class Features:
+    valid_power_levels = [
+        chirp_common.PowerLevel("High", watts=5),
+        chirp_common.PowerLevel("Low", watts=1),
+    ]
+
+
+class FakeRadio:
+    VENDOR = "Baofeng"
+    MODEL = "UV-5R"
+
+    def __init__(self):
+        self.memories = {}
+        self.set_calls = []
+        self.erase_calls = []
+        self.saved = []
+
+    def get_memory(self, number):
+        if number in self.memories:
+            return self.memories[number].dupe()
+        memory = chirp_common.Memory()
+        memory.number = number
+        memory.empty = True
+        return memory
+
+    def set_memory(self, memory):
+        self.set_calls.append(memory.number)
+        self.memories[memory.number] = memory.dupe()
+
+    def erase_memory(self, number):
+        self.erase_calls.append(number)
+        self.memories.pop(number, None)
+
+    def validate_memory(self, memory):
+        if not 136_000_000 <= memory.freq <= 520_000_000:
+            return ["Frequency is outside the UV-5R range"]
+        return []
+
+    def get_features(self):
+        return Features()
+
+    def save(self, filename):
+        self.saved.append(filename)
+
+
+def memory(number, name, frequency):
+    result = chirp_common.Memory()
+    result.number = number
+    result.name = name
+    result.freq = frequency
+    result.mode = "FM"
+    result.power = Features.valid_power_levels[0]
+    return result
+
