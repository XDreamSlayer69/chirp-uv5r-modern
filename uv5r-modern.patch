+class RepeaterBookWorker(QtCore.QObject):
+    progress = QtCore.Signal(int, str)
+    completed = QtCore.Signal(object)
+    failed = QtCore.Signal(str)
+
+    def __init__(self, params):
+        super().__init__()
+        self.params = params
+
+    @QtCore.Slot()
+    def run(self):
+        source = repeaterbook.RepeaterBook()
+        worker = self
+
+        class Status:
+            def send_status(self, message, percent):
+                worker.progress.emit(int(percent), message)
+
+            def send_end(self):
+                worker.completed.emit(source._memories)
+
+            def send_fail(self, reason):
+                worker.failed.emit(str(reason))
+
+            set_fail = send_fail
+
+        try:
+            source.do_fetch(Status(), dict(self.params))
+        except Exception as error:
+            self.failed.emit("%s\n\n%s" % (error, traceback.format_exc()))
+
