+++ b/chirp/uv5r_setup.py
@@ -0,0 +1,104 @@
+"""Baofeng UV-5R starter-channel planning helpers."""
+
+from chirp import chirp_common
+from chirp.sources import base
+
+
+UV5R_RANGES = (
+    (136_000_000, 174_000_000),
+    (400_000_000, 520_000_000),
+)
+MAX_CHANNELS = 128
+
+CALLING_CHANNELS = (
+    ("2M CALL", 146_520_000),
+    ("70CMCALL", 446_000_000),
+)
+
+NOAA_CHANNELS = (
+    ("WX1", 162_550_000),
+    ("WX2", 162_400_000),
+    ("WX3", 162_475_000),
+    ("WX4", 162_425_000),
+    ("WX5", 162_450_000),
+    ("WX6", 162_500_000),
+    ("WX7", 162_525_000),
+)
+
+
+def _memory(name, frequency, receive_only=False):
+    memory = chirp_common.Memory()
+    memory.name = name
+    memory.freq = frequency
+    memory.mode = "FM"
+    memory.duplex = "off" if receive_only else ""
+    memory.comment = (
+        "Receive only - NOAA Weather Radio"
+        if receive_only else "Amateur calling frequency"
+    )
+    return memory
+
+
+def in_uv5r_range(frequency):
+    return any(low <= frequency <= high for low, high in UV5R_RANGES)
+
+
+def is_analog(memory):
+    return memory.mode in ("", "Auto", "FM", "NFM")
+
+
+def memory_key(memory):
+    """Treat repeat listings for the same RF pair as duplicates."""
+    tx_frequency = memory.freq
+    if memory.duplex == "+":
+        tx_frequency += memory.offset
+    elif memory.duplex == "-":
+        tx_frequency -= memory.offset
+    elif memory.duplex == "split":
+        tx_frequency = memory.offset
+    elif memory.duplex == "off":
+        tx_frequency = 0
+    return memory.freq, tx_frequency
+
+
+def build_plan(repeater_memories=(), add_calling=True, add_noaa=True,
+               maximum=MAX_CHANNELS):
+    """Build a UV-5R-compatible list, preserving the requested order."""
+    candidates = []
+    if add_calling:
+        candidates.extend(_memory(name, freq)
+                          for name, freq in CALLING_CHANNELS)
+    if add_noaa:
+        candidates.extend(_memory(name, freq, receive_only=True)
+                          for name, freq in NOAA_CHANNELS)
+    candidates.extend(memory.dupe() for memory in repeater_memories)
+
+    planned = []
+    seen = set()
+    for memory in candidates:
+        if not in_uv5r_range(memory.freq) or not is_analog(memory):
+            continue
+        key = memory_key(memory)
+        if key in seen:
+            continue
+        seen.add(key)
+        memory.number = len(planned)
+        memory.name = memory.name[:7]
+        if memory.mode in ("", "Auto"):
+            memory.mode = "FM"
+        planned.append(memory)
+        if len(planned) == maximum:
+            break
+    return planned
+
+
+class UV5RSetupResult(base.NetworkResultRadio):
+    VENDOR = "Baofeng"
+    MODEL = "UV-5R Setup"
+
+    def __init__(self, memories):
+        super().__init__()
+        self._memories = memories
+
+    def get_label(self):
+        return "UV-5R Setup"
