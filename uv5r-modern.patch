+    def refresh_ports(self):
+        current = self.port.currentData()
+        self.port.clear()
+        for info in sorted(list_ports.comports(), key=lambda item: item.device):
+            self.port.addItem("%s · %s" % (info.device, info.description),
+                              info.device)
+        if current:
+            index = self.port.findData(current)
+            if index >= 0:
+                self.port.setCurrentIndex(index)
+        if not self.port.count():
+            self.port.addItem("No programming cable found", None)
+
+    def confirm_radio_ready(self, operation):
+        prompt = getattr(uv5r.BaofengUV5R.get_prompts(),
+                         "pre_%s" % operation)
+        return QtWidgets.QMessageBox.question(
+            self, "%s UV‑5R" % operation.title(), prompt,
+            QtWidgets.QMessageBox.Ok | QtWidgets.QMessageBox.Cancel
+        ) == QtWidgets.QMessageBox.Ok
+
+    def run_radio(self, operation):
+        port = self.port.currentData()
+        if not port:
+            QtWidgets.QMessageBox.warning(
+                self, "No cable", "Connect a programming cable first.")
+            return
+        if operation == "upload" and not self.radio:
+            return
+        if not self.confirm_radio_ready(operation):
+            return
+        self.progress.setValue(0)
+        self.progress.show()
+        self.download_button.setEnabled(False)
+        self.upload_button.setEnabled(False)
+        self.thread = QtCore.QThread(self)
+        self.worker = RadioWorker(operation, port, self.radio)
+        self.worker.moveToThread(self.thread)
+        self.thread.started.connect(self.worker.run)
+        self.worker.progress.connect(self.radio_progress)
+        self.worker.completed.connect(
+            lambda radio: self.radio_complete(operation, radio))
+        self.worker.failed.connect(self.radio_failed)
+        self.worker.completed.connect(self.thread.quit)
+        self.worker.failed.connect(self.thread.quit)
+        self.thread.finished.connect(self.worker.deleteLater)
+        self.thread.finished.connect(self.thread.deleteLater)
+        self.thread.start()
+
+    def download_radio(self):
+        if not self.confirm_discard_changes(
+                "Download and replace the current unsaved image?"):
+            return
+        self.run_radio("download")
+
+    def upload_radio(self):
+        if not self.radio:
+            QtWidgets.QMessageBox.information(
+                self, "Nothing to upload",
+                "Download from your UV-5R or open a radio image first.")
+            return
+        if self.offline_plan:
+            QtWidgets.QMessageBox.warning(
+                self, "Download required",
+                "This is an offline planning image. Download from your "
+                "actual UV-5R before uploading so its firmware-specific "
+                "settings are preserved.")
+            return
+        try:
+            self.commit_table()
+        except (TypeError, ValueError) as error:
+            QtWidgets.QMessageBox.warning(
+                self, "Invalid channel data", str(error))
+            return
+        answer = QtWidgets.QMessageBox.warning(
+            self, "Confirm upload",
+            "Uploading overwrites the radio. Confirm that you saved a backup.",
+            QtWidgets.QMessageBox.Yes | QtWidgets.QMessageBox.Cancel,
+            QtWidgets.QMessageBox.Cancel)
+        if answer == QtWidgets.QMessageBox.Yes:
+            self.run_radio("upload")
+
+    def radio_progress(self, value, message):
+        self.progress.setValue(value)
+        self.statusBar().showMessage(message)
+
+    def radio_complete(self, operation, radio):
+        self.progress.hide()
+        self.radio = radio
+        if operation == "download":
+            self.filename = None
+            self.offline_plan = False
+            self.load_table()
+            self.modified = True
+            self.statusBar().showMessage(
+                "Downloaded successfully · save a backup before editing")
+        else:
+            self.modified = False
+            self.statusBar().showMessage("Upload completed successfully")
+        self.update_state()
+
+    def radio_failed(self, details):
+        self.progress.hide()
+        self.update_state()
+        QtWidgets.QMessageBox.critical(
+            self, "Radio communication failed", details)
+
+    def open_image(self):
+        if not self.confirm_discard_changes(
+                "Open another image and discard the current unsaved changes?"):
+            return
+        filename, _ = QtWidgets.QFileDialog.getOpenFileName(
+            self, "Open CHIRP radio image", "", "CHIRP images (*.img);;All (*)")
+        if not filename:
+            return
+        try:
+            self.radio = directory.get_radio_by_image(filename)
+            self.filename = filename
+            self.offline_plan = bool(
+                self.radio.metadata.get("uv5r_modern_offline_plan"))
+            self.modified = False
+            self.load_table()
+            self.update_state()
+            self.statusBar().showMessage("Opened %s" % filename)
+        except Exception as error:
+            QtWidgets.QMessageBox.critical(self, "Unable to open image",
+                                           str(error))
+
+    def save_image(self):
+        self.ensure_workspace()
+        try:
+            self.commit_table()
+        except (TypeError, ValueError) as error:
+            QtWidgets.QMessageBox.warning(
+                self, "Invalid channel data", str(error))
+            return
+        filename = self.filename
+        if not filename:
+            filename, _ = QtWidgets.QFileDialog.getSaveFileName(
+                self, "Save radio image", "UV5R-backup.img",
+                "CHIRP images (*.img)")
+        if not filename:
+            return
+        try:
+            self.radio.save(filename)
+        except Exception as error:
+            QtWidgets.QMessageBox.critical(
+                self, "Unable to save image", str(error))
+            return
+        self.filename = filename
+        self.modified = False
+        self.update_state()
+        self.statusBar().showMessage("Saved %s" % filename)
+
+    def load_table(self):
+        self._loading = True
+        for row in range(128):
+            memory = self.radio.get_memory(row)
+            values = self.memory_values(memory)
+            for column, value in enumerate(values):
+                item = QtWidgets.QTableWidgetItem(value)
+                if column == 0:
+                    item.setFlags(item.flags() & ~QtCore.Qt.ItemIsEditable)
+                self.table.setItem(row, column, item)
+            self.table.setRowHidden(row, False)
+        self._loading = False
+        self.update_state()
+
+    @staticmethod
+    def memory_values(memory):
+        if memory.empty:
+            return (str(memory.number + 1), "", "", "", "", "", "",
+                    "FM", "High", "")
+        power = str(memory.power) if memory.power else "High"
+        tone = ""
+        if memory.tmode in ("Tone", "TSQL"):
+            tone = "%.1f" % (memory.rtone if memory.tmode == "Tone"
+                             else memory.ctone)
+        elif memory.tmode == "DTCS":
+            tone = str(memory.dtcs)
+        return (
+            str(memory.number + 1), memory.name,
+            chirp_common.format_freq(memory.freq), memory.duplex,
+            chirp_common.format_freq(memory.offset) if memory.offset else "",
+            memory.tmode, tone, memory.mode, power,
+            "Skip" if memory.skip == "S" else "",
+        )
+
+    def memory_from_row(self, row):
+        def text(column):
+            item = self.table.item(row, column)
+            return item.text().strip() if item else ""
+        memory = chirp_common.Memory()
+        memory.number = row
+        memory.name = text(1)[:7]
+        if not text(2):
+            memory.empty = True
+            return memory
+        memory.freq = chirp_common.parse_freq(text(2))
+        memory.duplex = text(3)
+        memory.offset = (chirp_common.parse_freq(text(4))
+                         if text(4) else 0)
+        memory.tmode = text(5)
+        tone = text(6)
+        if memory.tmode == "Tone" and tone:
+            memory.rtone = float(tone)
+        elif memory.tmode == "TSQL" and tone:
+            memory.ctone = float(tone)
+        elif memory.tmode == "DTCS" and tone:
+            memory.dtcs = int(tone)
+        memory.mode = text(7) or "FM"
+        levels = self.radio.get_features().valid_power_levels
+        memory.power = next(
+            (level for level in levels if str(level) == text(8)),
+            levels[0] if levels else None)
+        memory.skip = "S" if text(9).lower().startswith("skip") else ""
+        return memory
+
+    def commit_table(self):
+        if not self.radio:
+            return
+        memories = []
+        for row in range(128):
+            memory = self.memory_from_row(row)
+            if not memory.empty:
+                errors = self.radio.validate_memory(memory)
+                if errors:
+                    raise ValueError(
+                        "Channel %d: %s" % (row + 1, "; ".join(
+                            str(error) for error in errors)))
+            memories.append(memory)
+        for row, memory in enumerate(memories):
+            if memory.empty:
+                self.radio.erase_memory(row)
+            else:
+                self.radio.set_memory(memory)
+
+    def setup_assistant(self):
+        dialog = SetupDialog(self)
+        if dialog.exec() != QtWidgets.QDialog.Accepted:
+            return
+        self.ensure_workspace()
+        try:
+            self.commit_table()
+        except (TypeError, ValueError) as error:
+            QtWidgets.QMessageBox.warning(
+                self, "Invalid channel data", str(error))
+            return
+        existing = []
+        for row in range(128):
+            memory = self.radio.get_memory(row)
+            if not memory.empty:
+                existing.append(memory)
+        if dialog.nearby.isChecked():
+            self.setup_request = {
+                "existing": existing,
+                "calling": dialog.calling.isChecked(),
+                "noaa": dialog.noaa.isChecked(),
+            }
+            self.progress.setValue(0)
+            self.progress.show()
+            self.assistant_button.setEnabled(False)
+            self.statusBar().showMessage(
+                "Finding local analog repeaters...")
+            self.setup_thread = QtCore.QThread(self)
+            self.setup_worker = RepeaterBookWorker(
+                dialog.repeater_params())
+            self.setup_worker.moveToThread(self.setup_thread)
+            self.setup_thread.started.connect(self.setup_worker.run)
+            self.setup_worker.progress.connect(self.radio_progress)
+            self.setup_worker.completed.connect(
+                self.setup_repeaters_complete)
+            self.setup_worker.failed.connect(self.setup_repeaters_failed)
+            self.setup_worker.completed.connect(self.setup_thread.quit)
+            self.setup_worker.failed.connect(self.setup_thread.quit)
+            self.setup_thread.finished.connect(
+                self.setup_worker.deleteLater)
+            self.setup_thread.finished.connect(
+                self.setup_thread.deleteLater)
+            self.setup_thread.start()
+            return
+        self.apply_setup_plan(
+            existing, [],
+            dialog.calling.isChecked(), dialog.noaa.isChecked())
+
+    def apply_setup_plan(self, existing, repeaters, add_calling, add_noaa):
+        planned = uv5r_setup.build_plan(
+            list(existing) + list(repeaters),
+            add_calling=add_calling,
+            add_noaa=add_noaa)
+        self.write_plan(planned)
+        self.load_table()
+        self.modified = True
+        self.update_state()
+        self.statusBar().showMessage(
+            "Setup assistant prepared %d channels" % len(planned))
+        return planned
+
+    def write_plan(self, planned):
+        power_levels = self.radio.get_features().valid_power_levels
+        for memory in planned:
+            if power_levels:
+                requested = str(memory.power) if memory.power else ""
+                memory.power = next(
+                    (level for level in power_levels
+                     if str(level) == requested),
+                    power_levels[0])
+            self.radio.set_memory(memory)
+        for row in range(len(planned), 128):
+            try:
+                self.radio.erase_memory(row)
+            except Exception:
+                pass
+
+    def setup_repeaters_complete(self, repeaters):
+        request = self.setup_request
+        planned = self.apply_setup_plan(
+            request["existing"], repeaters,
+            request["calling"], request["noaa"])
+        self.progress.hide()
+        self.assistant_button.setEnabled(True)
+        baseline = uv5r_setup.build_plan(
+            request["existing"],
+            add_calling=request["calling"],
+            add_noaa=request["noaa"])
+        added = max(0, len(planned) - len(baseline))
+        QtWidgets.QMessageBox.information(
+            self, "Setup complete",
+            "Prepared %d channels, including %d compatible local analog "
+            "repeaters." % (len(planned), added))
+
+    def setup_repeaters_failed(self, details):
+        self.progress.hide()
+        self.assistant_button.setEnabled(True)
+        self.update_state()
+        QtWidgets.QMessageBox.critical(
+            self, "Local repeater lookup failed", details)
+
+    def find_repeaters(self):
+        dialog = RepeaterBookDialog(self)
+        if dialog.exec() != QtWidgets.QDialog.Accepted:
+            return
+        self.ensure_workspace()
+        try:
+            self.commit_table()
+        except (TypeError, ValueError) as error:
+            QtWidgets.QMessageBox.warning(
+                self, "Invalid channel data", str(error))
+            return
+        self.progress.setValue(0)
+        self.progress.show()
+        self.statusBar().showMessage("Connecting to RepeaterBook…")
+        self.rb_thread = QtCore.QThread(self)
+        self.rb_worker = RepeaterBookWorker(dialog.params())
+        self.rb_worker.moveToThread(self.rb_thread)
+        self.rb_thread.started.connect(self.rb_worker.run)
+        self.rb_worker.progress.connect(self.radio_progress)
+        self.rb_worker.completed.connect(self.repeaters_complete)
+        self.rb_worker.failed.connect(self.repeaters_failed)
+        self.rb_worker.completed.connect(self.rb_thread.quit)
+        self.rb_worker.failed.connect(self.rb_thread.quit)
+        self.rb_thread.finished.connect(self.rb_worker.deleteLater)
+        self.rb_thread.finished.connect(self.rb_thread.deleteLater)
+        self.rb_thread.start()
+
+    def repeaters_complete(self, repeaters):
+        existing = []
+        for row in range(128):
+            memory = self.radio.get_memory(row)
+            if not memory.empty:
+                existing.append(memory)
+        before = len(existing)
+        planned = uv5r_setup.build_plan(
+            existing + list(repeaters),
+            add_calling=False,
+            add_noaa=False)
+        self.write_plan(planned)
+        self.progress.hide()
+        self.load_table()
+        self.modified = True
+        self.update_state()
+        added = max(0, len(planned) - before)
+        self.statusBar().showMessage(
+            "Added %d compatible repeaters · %d channels total"
+            % (added, len(planned)))
+        QtWidgets.QMessageBox.information(
+            self, "RepeaterBook complete",
+            "Added %d compatible analog repeaters. Digital-only, duplicate, "
+            "out-of-range, and over-limit entries were removed." % added)
+
+    def repeaters_failed(self, details):
+        self.progress.hide()
+        self.update_state()
+        QtWidgets.QMessageBox.critical(
+            self, "RepeaterBook lookup failed", details)
+
+    def add_channel(self):
+        self.ensure_workspace()
+        for row in range(128):
+            if not self.table.item(row, 2).text().strip():
+                self.table.selectRow(row)
+                self.table.scrollToItem(self.table.item(row, 0))
+                self.table.editItem(self.table.item(row, 1))
+                return
+        QtWidgets.QMessageBox.information(
+            self, "Radio full", "The UV‑5R limit is 128 channels.")
+
+    def delete_selected(self):
+        if not self.radio:
+            QtWidgets.QMessageBox.information(
+                self, "Nothing to delete",
+                "There are no channels in the workspace yet.")
+            return
+        rows = {index.row() for index in self.table.selectedIndexes()}
+        if not rows:
+            QtWidgets.QMessageBox.information(
+                self, "Select a channel",
+                "Select one or more channel rows to delete.")
+            return
+        self._loading = True
+        for row in rows:
+            for column in range(1, len(self.COLUMNS)):
+                self.table.setItem(row, column, QtWidgets.QTableWidgetItem(""))
+        self._loading = False
+        self.modified = True
+        self.update_state()
+
+    def cell_changed(self, _item):
+        if not self._loading:
+            self.modified = True
+            self.update_state()
+
+    def apply_filter(self, query):
+        query = query.strip().lower()
+        for row in range(128):
+            content = " ".join(
+                self.table.item(row, column).text().lower()
+                for column in (1, 2)
+                if self.table.item(row, column))
+            self.table.setRowHidden(row, bool(query and query not in content))
+
+    def update_state(self):
+        loaded = self.radio is not None
+        programmed = 0
+        if loaded:
+            programmed = sum(
+                not self.radio.get_memory(row).empty for row in range(128))
+        self.channel_metric.setText("%d / 128" % programmed)
+        self.radio_metric.setText(
+            ("%s %s (offline)" % (self.radio.VENDOR, self.radio.MODEL)
+             if self.offline_plan else
+             "%s %s" % (self.radio.VENDOR, self.radio.MODEL))
+            if loaded else "Not loaded")
+        self.change_metric.setText("Unsaved" if self.modified else "Saved")
+        self.save_button.setEnabled(True)
+        self.upload_button.setEnabled(True)
+        self.assistant_button.setEnabled(True)
+        self.add_button.setEnabled(True)
+        self.delete_button.setEnabled(True)
+        self.download_button.setEnabled(True)
+
+    def ensure_workspace(self):
+        if self.radio:
+            return self.radio
+        data = b"\xFF" * 0x1948
+        self.radio = uv5r.BaofengUV5R(memmap.MemoryMapBytes(data))
+        self.radio.metadata = {"uv5r_modern_offline_plan": True}
+        self.filename = None
+        self.offline_plan = True
+        self.modified = True
+        self.load_table()
+        self.update_state()
+        self.statusBar().showMessage(
+            "Created a blank offline UV-5R planning workspace")
+        return self.radio
+
+    def confirm_discard_changes(self, message):
+        if not self.modified:
+            return True
+        return QtWidgets.QMessageBox.question(
+            self, "Unsaved changes", message,
+            QtWidgets.QMessageBox.Yes | QtWidgets.QMessageBox.Cancel,
+            QtWidgets.QMessageBox.Cancel) == QtWidgets.QMessageBox.Yes
+
+    def closeEvent(self, event):
+        if self.modified:
+            answer = QtWidgets.QMessageBox.question(
+                self, "Unsaved changes",
+                "Close without saving the current radio image?",
+                QtWidgets.QMessageBox.Yes | QtWidgets.QMessageBox.Cancel,
+                QtWidgets.QMessageBox.Cancel)
+            if answer != QtWidgets.QMessageBox.Yes:
+                event.ignore()
+                return
+        event.accept()
+
+
+def main():
+    app = QtWidgets.QApplication(sys.argv)
+    app.setApplicationName("CHIRP Modern")
+    app.setStyle("Fusion")
+    app.setStyleSheet(APP_STYLE)
+    window = ModernWindow()
+    window.show()
+    sys.exit(app.exec())
