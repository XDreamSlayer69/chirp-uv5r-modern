+def open_serial(port, radio_class=uv5r.BaofengUV5R):
+    pipe = serial.Serial(
+        port=port,
+        baudrate=radio_class.BAUD_RATE,
+        timeout=0.25,
+        rtscts=radio_class.HARDWARE_FLOW,
+    )
+    pipe.rts = radio_class.WANTS_RTS
+    pipe.dtr = radio_class.WANTS_DTR
+    return pipe
+
+
+class RadioWorker(QtCore.QObject):
+    progress = QtCore.Signal(int, str)
+    completed = QtCore.Signal(object)
+    failed = QtCore.Signal(str)
+
+    def __init__(self, operation, port, radio=None):
+        super().__init__()
+        self.operation = operation
+        self.port = port
+        self.radio = radio
+
+    @QtCore.Slot()
+    def run(self):
+        pipe = None
+        try:
+            pipe = open_serial(self.port)
+            if self.operation == "download":
+                radio = uv5r.BaofengUV5R(pipe)
+            else:
+                radio = self.radio
+                radio.pipe = pipe
+
+            def status(value):
+                maximum = value.max or 1
+                percent = int(value.cur / maximum * 100)
+                self.progress.emit(percent, value.msg)
+
+            radio.status_fn = status
+            getattr(radio, "sync_in" if self.operation == "download"
+                    else "sync_out")()
+            radio.pipe = None
+            self.completed.emit(radio)
+        except Exception as error:
+            self.failed.emit("%s\n\n%s" % (error, traceback.format_exc()))
+        finally:
+            if pipe:
+                try:
+                    pipe.close()
+                except Exception:
+                    pass
+
